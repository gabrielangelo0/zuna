{
  "name": "zuna",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w @zuna/server\" \"npm run dev -w @zuna/client\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "assets:download": "node tools/download-assets.mjs",
    "brand": "./tools/make-brand.sh",
    "bake": "npm run bake -w @zuna/baker",
    "postinstall": "node tools/fix-better-call.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "typescript": "^7.0.2"
  }
}
